# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# --- LiveKit Cloud ---------------------------------------------------------
# From your project's Settings -> Keys page.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Models ----------------------------------------------------------------
# These default to LiveKit Inference, their managed gateway, so the LiveKit
# credentials above cover STT, LLM, and TTS with no other provider account.
# Override any one of them to point at a different model.
TURNEVAL_STT=assemblyai/universal-streaming:en
TURNEVAL_LLM=openai/gpt-4o-mini
TURNEVAL_TTS=cartesia/sonic-2:9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# To use your own provider keys instead, swap the model strings for plugin
# instances in agents/booking_agent.py and set the matching keys here:
# ASSEMBLYAI_API_KEY=
# OPENAI_API_KEY=
# CARTESIA_API_KEY=

# --- Harness ---------------------------------------------------------------
# Set per call so the trace records which scenario it was running. Without it
# the scorer cannot match the trace to its ground truth and skips the session.
# TURNEVAL_SCENARIO_ID=happy-path

# Set by the tool-failure scenario to make book_appointment raise on purpose.
# TURNEVAL_FAULT=tool_error

# Optional overrides.
# TURNEVAL_SESSION_ID=
# TURNEVAL_TRACE_DIR=data/traces
# TURNEVAL_BOOKING_DIR=data/bookings
